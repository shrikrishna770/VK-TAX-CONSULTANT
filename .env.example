# Copy to .env.local (never commit real values).
# Configure at least ONE lead delivery channel in production, otherwise the form returns an error.

# Google Apps Script web app URL that appends rows to a Google Sheet.
# Payload fields: fullName, phone, email, service, message, page, receivedAt
GOOGLE_SCRIPT_URL=

# Email notification for each new lead via Resend (https://resend.com)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Must be a verified sender domain in Resend, e.g. "VK Tax Website <leads@vktaxconsultant.com>"
LEAD_FROM_EMAIL=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
